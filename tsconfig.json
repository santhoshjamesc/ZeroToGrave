{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest", "node"],
    "paths": {
      "@engine/*": ["./src/engine/*"],
      "@ui/*": ["./src/ui/*"],
      "@content/*": ["./src/content/*"],
      "@store/*": ["./src/store/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src", "scripts", "App.tsx", "index.ts"]
}
